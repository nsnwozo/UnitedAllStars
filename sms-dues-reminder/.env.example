# Path to the members CSV file (relative or absolute)
MEMBERS_CSV_PATH=sample_data/members_sample.csv

# Twilio credentials (never commit real values)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_NUMBER=+15555550123

# Optional: override the default SMS text. Must contain {name} and {balance}.
MESSAGE_TEMPLATE=Hi {name}, this is a reminder that your outstanding dues balance is ${balance}. Please settle it at your earliest convenience. Thank you.
